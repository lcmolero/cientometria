@article{ WOS:000454467500004,
Author = {Immordino, Giovanni and Russo, Francesco Flaviano},
Title = {Cashless payments and tax evasion},
Journal = {EUROPEAN JOURNAL OF POLITICAL ECONOMY},
Year = {2018},
Volume = {55},
Pages = {36-43},
Month = {DEC},
Abstract = {Cashless payments hinder tax evasion because they build a trail for the
   underlying transactions. Using European data, we find empirical evidence
   supporting this claim: credit and debit card payments are negatively
   related to VAT evasion. We also find that using electronic cards to
   withdraw cash at ATMs, by making cash more abundant, fosters VAT
   evasion.C},
