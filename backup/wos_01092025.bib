@inproceedings{ WOS:000346148300014,
Author = {Vohnout, Rudolf and Rihova, Zora and Brehovsky, Petr},
Editor = {Petr, D and Gerhard, C and Vaclav, O},
Title = {CASH HOLDINGS PROFITABILITY THRESHOLD MODEL},
Booktitle = {IDIMT-2014: NETWORKING SOCIETIES - COOPERATION AND CONFLICT},
Series = {Schriftenreihe Informatik},
Year = {2014},
Volume = {43},
Pages = {125-132},
Note = {22nd Interdisciplinary Information Management Talks (IDIMT) Conference,
   Podebrady, CZECH REPUBLIC, SEP 10-12, 2014},
Organization = {GACR; Univ Econ Prague; Johannes Kepler Univ Linz; CESKAS Sporitelna},
Abstract = {The main question for merchants from the very beginning of cashless
   payments is if it is worth it to have the terminal to accept credit or
   debit cards. What is the amount of cash flow, which delimits the cash
   holdings to still be profitable? This paper tries to give answers to
