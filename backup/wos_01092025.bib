EISSN = {1360-063X},
Keywords = {developmental state; digital payments; governance; infrastructure;
   policy; smart cities; technology},
Keywords-Plus = {GLOBAL CITY; DISCOURSE; REFLECTIONS; GOVERNMENT; URBANISM; CITIES; STATE},
