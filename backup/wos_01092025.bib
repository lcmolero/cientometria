@article{ WOS:000609024300007,
Author = {Kaur, Sandeep and Walia, Nidhi},
Title = {Impact of Demonetization on Digital Payments in India Event Study
   Methodology},
Journal = {PACIFIC BUSINESS REVIEW INTERNATIONAL},
Year = {2020},
Volume = {13},
Number = {4},
Pages = {16-29},
Month = {OCT},
Abstract = {The abrupt announcement of demonetization of higher denomination notes
   in India and aftermath prolonged cash crunch provided a shift towards
   digital transactions. The present study is trying to analyze the impact
   of demonetization on digital transactions by employing event study
   methodology. From comparison of pre and post event window, it has been
   observed that demonetization had no significant impact on use of eight
   variables of digital payment system. However, despite the increased
   efforts of government to push for cashless economy India still remained
   a cash intensive economy with uptrend in currency in circulation to GDP
   ratio. So, to bring permanent change continued efforts on digitization
   need to be made.},
