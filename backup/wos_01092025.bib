@inproceedings{ WOS:000505164900020,
Author = {Krivosheya, Egor},
Editor = {Cermakova, K and Mozayeni, S and Hromada, E},
Title = {NETWORK EFFECTS AT RETAIL PAYMENTS MARKET: EVIDENCE FROM RUSSIAN
   MERCHANTS},
Booktitle = {PROCEEDINGS OF THE 10TH ECONOMICS \& FINANCE CONFERENCE},
Year = {2018},
Pages = {288-322},
Note = {10th Economics and Finance Conference, Rome, ITALY, SEP 10-13, 2018},
Organization = {Int Inst Social \& Econ Sci},
Abstract = {This research examines the role of network externalities in card
   acceptance by merchants on the retail payments market in Russia. The
   work empirically tests the effects of both direct and indirect network
   externalities for the merchants' card acceptance probability based on
   the representative survey of 800 traditional (offline) merchants from
   all Russian regions. The main finding of this study is that the
   probability of cashless payments acceptance by merchants increases with
   the presence of direct and indirect or both types of network
   externalities, controlling for a large set of control variables,
   including merchants' characteristics and location-specific differences
   between the retailers. The results are robust to the changes in measures
   of network externalities and inclusion of shadow economy controls. The
   findings are significant both statistically and economically.},
