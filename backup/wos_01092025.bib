@article{ WOS:000218996000011,
Author = {Stryckova, Lenka},
Title = {TRENDS IN ELECTRONIC BANKING IN THE CZECH REPUBLIC},
Journal = {AD ALTA-JOURNAL OF INTERDISCIPLINARY RESEARCH},
Year = {2012},
Volume = {2},
Number = {1},
Pages = {48-52},
Abstract = {In recent years, the revolutionary technological advances have caused a
   substantial development in payment systems, not only in the Czech
   Republic, but all over the world. The Internet and other wireless
   communication technologies have not only changed the existing payment
   systems, they have even generated new ways and methods of providing
   banking services. This article focuses on the dynamics of the electronic
   banking in the CR. The goal of this paper is to track the latest trends
   in the electronic banking in the Czech Republic, and to detect the very
   near future of it. The paper focuses on the process of the replacement
   of the traditional brick-to-mortar banking by the click-to-mortar
   banking, and the replacement of cash transactions by cashless payments.},
