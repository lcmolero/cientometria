Title = {Supervised Machine Learning Algorithms for Credit Card Fraud Detection:
   A Comparison},
Booktitle = {PROCEEDINGS OF THE CONFLUENCE 2020: 10TH INTERNATIONAL CONFERENCE ON
   CLOUD COMPUTING, DATA SCIENCE \& ENGINEERING},
Year = {2020},
Pages = {680-683},
Note = {10th International Conference on Cloud Computing, Data Science and
   Engineering (Confluence), Amity Univ, Noida, INDIA, JAN 29-31, 2020},
Organization = {IEEE; Amity Univ, Amity Sch Engn \& Technol, Dept Comp Sci \& Engn},
Abstract = {In today's economic scenario, credit card use has become extremely
   commonplace. These cards allow the user to make payments of large sums
   of money without the need to carry large sums of cash. They have
   revolutionized the way of making cashless payments and made making any
   sort of payments convenient fur the buyer. This electronic form of
   payment is extremely useful but comes with its own set of risks. With
   the increasing number of users, credit card frauds are also increasing
   at a similar pace. The credit card information of a particular
   individual can be collected illegally and can be used for fraudulent
   transactions. Some Machine Learning Algorithms can lie applied to
