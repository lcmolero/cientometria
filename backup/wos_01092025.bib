
@article{ WOS:000902487800001,
Author = {Srouji, Jeremy and Torre, Dominique},
Title = {The Global Pandemic, Laboratory of the Cashless Economy?},
Journal = {INTERNATIONAL JOURNAL OF FINANCIAL STUDIES},
Year = {2022},
Volume = {10},
Number = {4},
Month = {DEC},
Abstract = {The COVID-19 pandemic has had a profound impact on payment systems and
   preferences around the world, reducing the use of cash in favor of
   digital payment instruments and accelerating the discussion around the
   need for a central bank digital currency. This article presents the
   digital payments and cashless agenda before and after the pandemic,
   focusing on how the changing payments landscape has influenced the
   priorities and decisions of regulators, banks and other financial
   intermediaries, with regards to the future shape of payment systems. It
   finds that while the pandemic demonstrated the benefits associated with
   building an advanced, competitive and integrated digital payments
   eco-system, it has also brought to the forefront more fragmentation than
   convergence between payment systems in different regions of the world.},
