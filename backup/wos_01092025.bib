@inproceedings{ WOS:000518804700059,
Author = {Ranjan, Priyesh and Soman, Sumit and Ateria, Amit Kumar and Srivastava,
   Praveen K.},
Editor = {Hollmen, J and McGregor, C and Soda, P and Kane, B},
Title = {Streamlining Payment Workflows using a Patient Wallet for Hospital
   Information Systems},
Booktitle = {2018 31ST IEEE INTERNATIONAL SYMPOSIUM ON COMPUTER-BASED MEDICAL SYSTEMS
   (CBMS 2018)},
Series = {IEEE International Symposium on Computer-Based Medical Systems},
Year = {2018},
Pages = {339-344},
Note = {31st IEEE International Symposium on Computer-Based Medical Systems
   (CBMS), Karlstad Univ, Karlstad, SWEDEN, JUN 18-21, 2018},
Organization = {IEEE; IEEE Comp Soc; Technical Committee on Computational Life Sciences;
   Karlstad Univ Business Sch; Karlstad Univ, Dept Comp Sci},
Abstract = {Billing and payment modules of a Hospital Information System (HIS) are
   vital components responsible for monetization of healthcare delivery
   services provided by such systems. In today's age of digital payments
   and cashless transactions, it has become imperative to design these
   payment modules to support payments via multiple user interfaces and
   financial instruments. This would enable seamless operation of these
   modules, while also minimizing processing time in approval, and
   eventually, the delivery of healthcare services. In this paper, we
   present the concept of a ``patient wallet{''}, which provides mobile and
   web interfaces to enable patients to directly make digital payments for
   requisitions raised during different hospital workflows. The patient
   wallet maintains a user account balance and directly fetches
   transactions from the HIS, thereby enabling patients to easily make
   payments without the need for visiting the billing counter at medical
   facilities or referring to third party transaction instruments. The
   patient wallet is closely integrated with the operational architecture
   of the HIS, hence making its use simple and versatile, while minimizing
   integration effort and providing ubiquitous healthcare services with
   minimal delay.},
