Title = {Cash is King, Isn't It? Payment Preferences and Switching Intentions of
   German Customers},
Booktitle = {RESPONSIBLE AI AND ANALYTICS FOR AN ETHICAL AND INCLUSIVE DIGITIZED
   SOCIETY, I3E 2021},
