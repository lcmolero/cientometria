Title = {Passengers Acceptance of Cashless Payment System for Public Bus
   Transportation System in Kigali City (Rwanda)},
Booktitle = {ICACSIS 2020: 2020 12TH INTERNATIONAL CONFERENCE ON ADVANCED COMPUTER
