	author = {Ramli, Faten Aisyah Ahmad and Hamzah, Muhammad Iskandar and Wahab, Siti Norida and Shekhar, Rishabh},
	title = {Modeling the Brand Equity and Usage Intention of QR-Code E-Wallets},
	year = {2023},
