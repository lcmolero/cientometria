	pages = {7005 - 7030},
	doi = {10.1007/s10115-024-02177-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199457702&doi=10.1007%2Fs10115-024-02177-5&partnerID=40&md5=4b5776cdbd05c75fe349b7fbb7a9083c},
