	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85102880036&doi=10.1016%2Fj.techsoc.2021.101554&partnerID=40&md5=ee5409c97ca9cd1eaf6ddfe3a2ed8ba0},
