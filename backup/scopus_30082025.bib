	author = {Majumder, Sumedha and De, Shelly},
	title = {Innovative measures and sustainable growth of SMEs: A special reference to some selected enterprises in Howrah},
	year = {2024},
	pages = {155 - 170},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202910319&partnerID=40&md5=d445c39f14ab0d9cfddbe705e7da2c7b},
	affiliations = {Shree Agrasain College, Department of Commerce, Howrah, West Bengal, India; Bijoy Krishna Girls' College, Howrah, Department of Commerce, Howrah, India},
	abstract = {The COVID-19 pandemic lockdown had an adverse impact on the SMEs sector, resulting in negative growth in terms of production process, export¬import, employment, market demand, and liquidity. The lathe industry-based SMEs in Howrah district, West Bengal, were not an exception to this crisis. Therefore, the objectives of this study are to understand, analyze, and compare the sales, purchase, and profit of selected lathe industry-based enterprises in Howrah district, West Bengal, before and after the COVID-19 pandemic. The study will also identify and analyze the survival strategies and innovative measures taken by these selected SMEs in the new normal. The study is based on both primary and secondary data. The study found that more than 50% of the enterprises experienced a decline in sales with a negative CAGR from 2018-2019 to 2020-2021. The purchase of 50% of the selected enterprises also decreased between 2018 and 2019 & 2020 and 2021. Profit also decreased for these SMEs, although some of them showed positive growth in sales and profit with a positive and high CAGR. Innovative measures such as a combination of online-offline sales, cashless payments, home deliveries, and well-developed customer relationships played a crucial role in the existence and sustainable growth of these SMEs during the lockdown. © 2024 Elsevier B.V., All rights reserved.},
