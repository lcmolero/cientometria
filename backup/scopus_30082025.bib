@CONFERENCE{Pratap2023915,
	author = {Pratap, Vibha and Singh, Amit Prakash},
	title = {Comparison of Undersampling Methods for Imbalanced Credit Card Fraud Dataset},
	year = {2023},
	pages = {915 - 920},
	doi = {10.1109/AECE59614.2023.10428199},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186490708&doi=10.1109%2FAECE59614.2023.10428199&partnerID=40&md5=eeea9a4f5d88cbe019b91a8e0a422798},
	affiliations = {University School of Information, Communication & Technology, New Delhi, India; Indira Gandhi Delhi Technical University for Women, New Delhi, India},
	abstract = {We use credit cards for daily transactions such as shopping, bill payments, electricity bill payments, recharge of mobiles, set-top boxes, etc. We cannot avoid using cashless payments for an easy life. For online transactions, using credit cards is the most common way. Usually, transactions are legitimate, but there is still little chance of fraud. A class imbalance issue exists as only very few transactions are fraud out of a thousand transactions. We propose a new Attribute-clustering based undersampling algorithm to rebalance the credit card fraud dataset, which is highly imbalanced. The proposed approach enhances fraud detection accuracy for the credit card dataset. For the experiments, a credit card dataset is taken from Kaggle. We have also analyzed five undersampling methods: RUS, ROSE US, SBC, KMUS, and Center-1nn. Performances of all approaches under consideration are compared using seven different classifiers: SVM, Random Forest, RPART, XGBoost, KNN, Naïve Bayes, and LR. We used the F1 score, Precision, Recall, and Accuracy as accuracy metrics for performance comparisons. Experimental results show that the XGBoost is the best classifier with an Accuracy of 99.53% for the proposed method, which is the highest Accuracy among all experiments. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Kmus; Knn; Lr; Naïve Bayes; Random Forest; Rpart; Rus; Sbc; Svm; Xgboost; Clustering Algorithms; Random Forests; Support Vector Machines; Kmus; Knn; Lr; Naive Bayes; Rpart; Rus; Sbc; Svm; Xgboost; Crime},
	keywords = {Clustering algorithms; Random forests; Support vector machines; KMUS; KNN; LR; Naive bayes; RPART; RUS; SBC; SVM; Xgboost; Crime},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350330724},
	language = {English},
	type = {Conference paper},
