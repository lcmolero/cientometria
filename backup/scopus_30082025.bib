@ARTICLE{Rahbar2024453,
	author = {Rahbar, Ali and Rahmani-Fazli, Hadi and Davoodi, Parviz and Samsami Mazraee Akhond, Hossein},
	title = {The Effect of Electronic Money and New Payment Instruments on the Monetary Aggregation Variables and the Role of Banks in Inflation and Liquidity},
	year = {2024},
	journal = {Tasmimgiri va Tahqiq dar Amaliyyat},
