	affiliations = {JIS University, Kolkata, India; Sikkim University, Gangtok, India},
	abstract = {With the aim of providing accessible, safe, and transparent financial services to underprivileged and unbanked individuals, Digital Financial Services (DFS) serves as the foundation of Digital Financial Inclusion (DFI) in India. Through this program, consumers will have convenient access to digital banking and financial services via devices, retail agents, and digital trans¬actional platforms. The benefits include quick and easy access to financial resources for all, cost-effectiveness, tailored financial solutions, user-friend¬liness, and economic empowerment for women and other vulnerable groups in society. The Indian government's demonetization efforts in 2017 led to the creation of a digital economy, resulting in increased usage of digital payment services. However, challenges such as limited internet access, identity theft risks, and a lack of digital transaction point-of-sale devices persist. Utilizing digital banking systems and wallets is a prerequisite for digital financial services, and financial literacy is crucial for effective financial management and informed decision-making. While India's digital adoption score remains lower than that of the UK, South Korea, Sweden, and Singapore, efforts are needed to establish digital financial service infrastructure, particularly in rural and isolated areas with limited financial distribution networks, to ensure widespread mobile connectivity. The Indian government has been promoting online payments since 2016, driven by the 'Digital India' plan. The Universal Payment Interface (UPI) is the most widely used platform. India is transitioning into a cashless economy by equipping itself with specialized knowledge of digital platforms and financial literacy. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Demonetization; Digital Adoption; Digital Financial Inclusion; Digital Financial Literacy; Digital Payment Index; Digitalization; Reserve Bank Of India; Terrapay},
	publisher = {Apple Academic Press},
	isbn = {9781040103951; 9781774916544},
