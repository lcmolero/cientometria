@ARTICLE{Semerikova2024171,
	author = {Semerikova, Ekaterina},
	title = {Cashless payments beyond access: What influences the intensity of use?; Безналичные платежи за пределами доступности: что влияет на частоту использования?},
	year = {2024},
	journal = {Zhournal Novoi Ekonomicheskoi Associacii /Journal of the New Economic Association},
	volume = {64},
