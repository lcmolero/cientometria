	pages = {117 - 145},
	doi = {10.4018/979-8-3373-0390-1.ch005},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013196847&doi=10.4018%2F979-8-3373-0390-1.ch005&partnerID=40&md5=59ae9e420da0e7adfd787572b568b0f9},
	affiliations = {Taylor's University Malaysia, Subang Jaya, Malaysia},
	abstract = {United Nations predicts that 70% of the world's population will be living in urban areas by 2050. Malaysia is among the developing countries hopping on this bandwagon by realizing the nation's digitalization agenda towards Malaysia's smart city journey. Currently, Malaysia's smart city plans focus on two major areas: transport issues and cashless payments. However, there are more areas to be further developed in the smart city plans. To ensure Malaysia is ready, research into consumer behavior is needed. This is aligned with the 12th Malaysian Plan on digital transformation; Shared Prosperity Vision 2030; and fulfillment of SDG9. Nevertheless, empirical studies on factors influencing Malaysia's intention to purchase homes in smart cities are scarce. The current study conducts qualitative study of 20 in-depth interviews among diverse individuals in Malaysia. Findings from the major themes point to five main factors including security and privacy; environmental initiatives; digital infrastructures and smart mobility; digital literacy and knowledge expectancy; and price value. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Developing Countries; Smart City; Smart Homes; Sustainable City; Sustainable Development; Urban Planning; 'current; Digital Transformation; Empirical Studies; Malaysia; Malaysians; Qualitative Study; United Nations; Urban Areas; World Population; Consumer Behavior},
