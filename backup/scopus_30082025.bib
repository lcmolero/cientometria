	keywords = {Deep learning; Feature extraction; Fuzzy inference; Fuzzy neural networks; Wooden fences; Bootstrap; Credit card fraud detections; Credit card frauds; Credit cards; Decimal scaling; Deep neuro-fuzzy network; Distance-based features; Neuro-fuzzy network; Scalings; Zeiler and fergus network; Losses},
	publisher = {Springer Science and Business Media Deutschland GmbH},
