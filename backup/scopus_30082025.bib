@ARTICLE{Bahri2025,
	author = {Bahri, Saiful and Suroso, Arif Imam and Suhendi, null and Sari, Linda Karlina},
	title = {Examining Cash Usage Behavior in Metropolitan Greater Jakarta Societies},
	year = {2025},
	journal = {Societies},
