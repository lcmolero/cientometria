	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184545021&doi=10.4324%2F9781003258261-6&partnerID=40&md5=9e20c5cd6d76e105171dbae948da01f6},
	affiliations = {Saudi Central Bank, Riyadh, Saudi Arabia},
	abstract = {Central bank digital currencies raise old questions about the structure of the banking system and the monetary role central banks and commercial banks play in modern societies. Given that cryptocurrencies were initially designed to cut off intermediaries when transacting online because of the instability that affected commercial banks during the Global Financial Crisis, a one-tier CBDC design would place the central bank as a layer between peer-to-peer transactions. Therefore, such a design can change the balance achieved through centuries of central banking and financial sector development. Indeed, in most jurisdictions, commercial banks offer digital money to non-financial customers—while central banks issue (i) physical cash—i.e., banknotes to non-financial customers—and (ii) digital central bank money (required and supplementary reserves) to commercial banks. Overall, these two layers of digital money coexist reasonably well. However, the decline in cash use seen in several (but not all) jurisdictions as they move to cashless societies has tilted this balance towards commercial banks and attracted deposits that would typically have been held in central bank money. Depending on its design features, CBDCs could potentially reverse this tide by offering the public a default-free, presumably cheap medium of exchange with potentially higher anonymity. © 2024 Elsevier B.V., All rights reserved.},
	publisher = {Taylor and Francis},
	isbn = {9781003853305; 9781032192277},
	language = {English},
	type = {Book chapter},
	publication_stage = {Final},
