@ARTICLE{Ridwansyah202493,
	author = {Ridwansyah, null and Razimi, Mohd Shahril Bin Ahmad and Sisdianto, Ersi and Suprianingsih, Okta},
	title = {Central Bank Digital Currency (CBDC): An Innovation in E-Payment for Socio-Entrepreneurship},
	year = {2024},
