@ARTICLE{Fujiki202289,
	author = {Fujiki, Hiroshi},
	title = {Will The Widespread Use of Cashless Payments Reduce the Frequency of the Use of Cash Payments?},
	year = {2022},
	journal = {Review of Economic Analysis},
	volume = {14},
	number = {1},
	pages = {89 - 120},
	doi = {10.15353/rea.v13i3.4522},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85127367148&doi=10.15353%2Frea.v13i3.4522&partnerID=40&md5=f59081b93765e7bca93685232ca19723},
	affiliations = {Chuo University, Hachioji, Japan},
	abstract = {Will the widespread use of cashless payments reduce the frequency of the use of cash payments? This question is important because the major costs of cash use are fixed costs that would only be reduced if the frequency of cash payments substantially decreased, and thus the extent of the reduction of the cost of cash use depends on the frequency of cash use after the widespread use of cashless payment methods. Using the data from the Financial Literacy Survey 2019 in Japan, this paper shows that the frequency of cash use for those who use both cash and noncash payment methods and that of those who exclusively use cash are about once in 2.3 days and about once in 2 days, respectively, and thus there is only a slight difference. The result did not change even if a regression model for cash usage was used that considers the endogenous choice of payment methods or if counterfactual simulations of the decrease in consumers’ willingness to use cash were conducted. The results suggest that the benefit of reducing the cost of cash use due to the widespread use of cashless payment methods is overestimated because the frequency of the use of cash payments is unlikely to decrease despite the use of cashless payment methods. 4 Empty 10. © 2022 Elsevier B.V., All rights reserved.},
