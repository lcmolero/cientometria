@ARTICLE{Moro-Visconti2014420,
	author = {Moro-Visconti, Roberto and Quirici, Maria Cristina},
	title = {The impact of innovation and technology on microfinance sustainable governance},
	year = {2014},
	journal = {Corporate Ownership and Control},
	volume = {11},
	pages = {420 - 428},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84947754563&partnerID=40&md5=7a7325fb2c03d6d1610cc9ef3aac8176},
	affiliations = {Università Cattolica del Sacro Cuore, Department of Business Administration, Milan, Italy; Dipartimento di Economia e Management, Pisa, Italy},
	abstract = {Technical or social innovation, concerning also the creation and commercialization of new products, strategies and management, has a deep actual - and especially trendy - impact on microfinance institutions (MFIs), contributing to reshape their business model, with an impact on their overall risk profile. Innovation is mostly an opportunity even for MF risk mitigation, considering its pervasive impact on risk factors. This original analysis is addressing, in a multidisciplinary and innovative comprehensive way, apparently weakly related topics such as MF governance, and IT issues, within recessionary cycles. This hardly investigated frontier faces key trendy issues, which are likely to deeply reengineer the relationship among different stakeholders, as it has already happened, on a different and more sophisticated scale, with traditional banking. To the extent that technology (with access to Internet, social networks, cashless electronic payments, etc.) reshapes the equilibriums among different stakeholders, it is likely to have important – albeit under-investigated - corporate governance consequences, softening the conflicts of interest among stakeholders and reinforcing the business model, making it more resilient during recessions, with positive externalities on both sustainability and outreach. © 2020 Elsevier B.V., All rights reserved.},
	author_keywords = {Cashless Society; Ict; Mobile Banking; Outreach; Recession; Risk Management; Social Networks; Stakeholders},
	publisher = {Virtus Interpress alex_kostyuk@VirtusInterPress.org},
	issn = {17279232; 18103057},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 11}
}

