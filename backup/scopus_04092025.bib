	year = {2024},
	pages = {149 - 154},
	doi = {10.1145/3691422.3691463},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216774252&doi=10.1145%2F3691422.3691463&partnerID=40&md5=14b0a6dd7b607c80f38ce33fa6a319ab},
	affiliations = {Sunway University, Bandar Sunway, Malaysia; Ala-Too International University, Bishkek, Kyrgyzstan},
	abstract = {In modern day of Kyrgyzstan, gender relations are still strongly influenced by traditional beliefs. There is still a lack of empowerment of women, especially in the economic sector. The potential of digital financial inclusion to promote better economic opportunities for women is undeniable, therefore it is important to examine how the gender dynamics impact e-wallet adoption and usage in Kyrgyzstan. This study, which is based on the Theory of Reasoned Action (TRA), investigates how gender dynamics affect the relationship between attitude and subjective norms to intention to use e-wallets. A survey-based methodology collected 158 men and 161 women respondents in Kyrgyzstan giving 319 responses in total. By examining the factors impacting the use of e-wallets in Kyrgyzstan, this study intends to close this research gap. The adoption of e-wallets by the Kyrgyz men are influenced by their subjective norms, while Kyrgyz women adopt e-wallets influenced by their attitudes. This information offers helpful insights for marketers, companies, investors and other stakeholders looking to invest in the Kyrgyz e-wallet industry and gives the ability to customize their marketing strategies to encourage the adoption of gender-inclusive e-wallets. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Cashless Payment; Demographics; E-wallet Use; Gender; Kyrgyzstan; Theory Of Reasoned Action; Electronic Money; Cashless Payment; Consumer Culture; Demographic; E-wallet Use; Economic Sectors; Financial Inclusions; Gender; Kyrgyzstan; Subjective Norm; Theory Of Reasoned Action; Decentralized Finance},
