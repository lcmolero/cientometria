@ARTICLE{Unuabonah2024,
	author = {Unuabonah, Foluke Olayinka and Fifelola, Deborah Abiola},
	title = {‘Let’s buy money before buying food’: a multimodal critical discourse analysis of WhatsApp memes on the Nigerian Naira redesign policy},
	year = {2024},
