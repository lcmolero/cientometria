@ARTICLE{Thetlek2024264,
	author = {Thetlek, Ruangchan and Kraiwanit, Tanpat and Limna, Pongsakorn and Shaengchart, Yarnaphat and Moolngearn, Papon},
	title = {THE STRATEGY OF VIRTUAL BANKING ADOPTION IN THE DIGITAL ECONOMY},
	year = {2024},
