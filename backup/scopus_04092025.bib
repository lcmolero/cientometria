	title = {ELECTRONIC PAYMENTS AND MACROECONOMIC REGULATION IN CHINA},
	year = {2024},
	journal = {Journal of Nonlinear and Convex Analysis},
	volume = {25},
	number = {4},
	pages = {747 - 765},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196265446&partnerID=40&md5=fa292b269b5fb583f2e97963bb4e307c},
	affiliations = {Qingdao University, School of Business, Qingdao, China; Shandong Women’s University, School of Economics, Jinan, China; Nanjing University of Aeronautics and Astronautics, College of Economics and Management, Nanjing, China},
	abstract = {Electronic payments have developed rapidly due to continuous progress in electronic information technology. This study aimed to discuss the impact of the rapid development of electronic payments on the monetary system in terms of an increase in money supply, a reduction in money demand, and an acceleration in the velocity of money circulation. The changes in the monetary system had a huge impact on the policy effects of macroeconomic regulation, which was discussed in this paper with the IS - LM(Investment Equals Savings-Liquidity Preference and Money Supply) model. The changes in money supply compressed the space for expansionary monetary policy, while expanding the space for tightening monetary policy. The changes in money demand were more complex, monetary policy effects were enhanced, and fiscal policy effects were enhanced or weakened under different conditions. Measures should be taken to strengthen the theoretical research, promote the digitization of legal tender, enhance electronic payment monitoring, ensure the security of electronic payments, and optimize macroeconomic regulation policies to achieve a stable and healthy development of the economy of China. This study provided insights for better understanding the impact of electronic payment development and the role of effective macroeconomic regulation policies. © 2024 Elsevier B.V., All rights reserved.},
