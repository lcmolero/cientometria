@inproceedings{ WOS:001512885300015,
Author = {Zaja, Maja Mihelja and Sjaus, Branka Tuskan},
Editor = {Druzic, G and Beg, M},
Title = {A CASHLESS SOCIETY - IS IT FEASIBLE? AN ANALYSIS OF PAYMENT TRENDS},
Booktitle = {CONFERENCE PROCEEDINGS OF THE 5TH INTERNATIONAL CONFERENCE ON THE
   ECONOMICS OF THE DECOUPLING, ICED 2024},
Series = {International Conference on the Economics of the Decoupling},
Year = {2024},
Pages = {267-286},
Note = {5th International Conference on the ECONOMICS OF THE DECOUPLING-ICED,
   CROATIA, NOV 30-DEC 01, 2023},
Organization = {Croatian Academy of Sciences \& Arts},
Abstract = {The recent crisis caused by the COVID-19 pandemic significantly changed
   the behaviour of individuals in many areas, including payment habits.
   Although the importance of digital transformation and non-cash payments
   became particularly evident in the pandemic, the trends toward a
   cashless society have been discernible for a long time. However, is a
   cashless society possible and feasible? This paper aims to present the
   results of analysing both the trends and the main determinants of
   cashless payment transactions worldwide. The purpose is to identify the
   main impact factors that lead to a higher share of non-cash transactions
   and towards a cashless society, but also to answer the question of what
   causes significant differences between countries concerning the level
   and speed of changes. For that purpose, in the empirical research
   presented in the paper, different cash and non-cash payment indicators,
   and digital inclusion and financial inclusion indicators were analysed
   by applying the comparative analysis and descriptive statistics
   methodology on the data from the decade leading to 2022 in five world
   regions. The results of the study indicate that despite the significant
   and continuous growth trend of some cashless payment indicators, cash is
   still prevalent in transactions. This is especially true in less
   developed countries, where the financial exclusion indicator is high,
   and cash payments remain relatively common. Despite advancements in
   digitalisation, digital transformation and technological innovation in
   payments and payment systems, payment behaviour in these countries
   differs from that in developed countries. Due to higher levels of
   financial exclusion and other unfavourable socioeconomic, technological
   and/or cultural indicators, consumers' behaviour, customs and payment
   habits significantly differ in less developed countries from those in
   more developed ones, which is an important factor in the observed slower
   progress toward a cashless society. The results emphasised the
   importance and the growing trend of non-cash payment transactions, but
   also pointed to identified problems in moving towards a cashless
   society, such as insufficient financial inclusion and the degree of
   economic development. The results may be a valuable source of
   information in order to better understand the importance and the role of
   offer and acceptance of innovation, digitalisation and digital
   transformation solutions in the field of payments.},
