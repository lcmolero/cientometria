@inproceedings{ WOS:000460581800102,
Author = {Kleitman, Aleksandr L. and Ivanova, Tatiana B. and Timacheva, Elena V.},
Editor = {Popkova, EG},
Title = {Historical Experience of Development of the Tokens of Value and
   Scenarios of Its Modern Application},
Booktitle = {FUTURE OF THE GLOBAL FINANCIAL SYSTEM: DOWNFALL OR HARMONY},
Series = {Lecture Notes in Networks and Systems},
Year = {2019},
Volume = {57},
Pages = {954-961},
Note = {Conference on Future of the Global Financial System - Downfall or
   Harmony, Limassol, CYPRUS, APR 13-14, 2018},
Organization = {Inst Sci Commun},
Abstract = {The goal of the research is to develop new scenario of the world
   financial system architecture on the basis of the historical experience
   of applying new tokens of value. Methodology: historical evolution
   method with account of bifurcation points and scenario development
   determinants. Results: Different tokens of value have different exchange
   mechanisms that can be observed in differences between monetary
   aggregates of different countries and changes in world currency system.
   Countries common features include legally imposed order of tokens of
   value emission and circulation that enables the states to use financial
   system as one of the instruments of regulating public production. As the
   humanity develops new tokens of value appear. The article touches in
   more details upon Tulipmania and monetary reform in Russia in 1921-1924
   as possible bifurcation points of potential changes in payment systems.
   According to the first scenario the new currency failed. According to
   the second scenario old tokens of value were replaced by new ones. The
   choice of the development scenarios is determined by the government
   support regarding to new tokens of value. Taking it into consideration
   we carried out the analysis of crypto currencies perspectives as one of
   the directions of developing new architecture of the world financial
   system. The article observes crypto currencies evolution process and
   intensifying state regulation causing emerging of national gold-backed
   crypto currencies. Conclusions/recommendations: Historical experience
   shows that sustainability of the new tokens of value is provided by the
   state only by taking risks of their launching including measures aimed
   at regulating public production and limiting public expenditures.
   Emerged tokens of value (digital currencies) must have several levels:
   the first one making up the basis for new payment systems in the form of
   national gold-backed crypto currencies; and the second one being emitted
   by private entities that will become a kind of financial instruments.
   Creating such a system implies concluding cross-governmental agreements
   determining emission and circulation of new tokens of value. Changing
   the conventional order affecting economic interests of contracting
   states lead and will lead to forming a new harmonious system of by means
   of ruining the old one, and the outcome will depend on effectiveness of
   the concluded global treatments.},
