@article{ WOS:000731761900002,
Author = {Fraczek, Bozena and Urbanek, Anna},
Title = {Financial inclusion as an important factor influencing digital payments
   in passenger transport: A case study of EU countries},
Journal = {RESEARCH IN TRANSPORTATION BUSINESS AND MANAGEMENT},
Year = {2021},
Volume = {41},
Month = {DEC},
Abstract = {The digitalisation of payments is a major trend in passenger transport,
   and is very often seen as a condition for improving the efficiency of
   the services provided. The technology used for digital payments in
   passenger transport is constantly evolving. As in other areas, mobile
   technology is currently developing the most dynamically. This paper
   presents the rationale for the development of digital payments in
   passenger transport, and identifies various factors influencing the
   level of digital ticketing and payments in this sector. The study uses a
   macroeconomic approach and was carried out on a macro scale using
   aggregated data for European Union countries. Using the multiple linear
   regression method, the factors influencing digital payments in passenger
   transport were determined. The results obtained show that the level of
   digital payments in passenger transport depends on the degree of mobile
   device usage for accessing the internet on the move, as well as the
   level of financial inclusion provided through electronic banking
   services. The results of this study offer several important implications
   for the academic body of knowledge and for business practice, as well as
   indicating directions for future studies in this field.},
