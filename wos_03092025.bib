@article{ WOS:001254859700006,
Author = {Zhang, Jing and Liu, Cuicui and Liu, Yang and Zhang, Taile and Cui,
   Junfu},
Title = {ELECTRONIC PAYMENTS AND MACROECONOMIC REGULATION IN CHINA},
Journal = {JOURNAL OF NONLINEAR AND CONVEX ANALYSIS},
Year = {2024},
Volume = {25},
Number = {5},
Pages = {767-778},
Abstract = {Electronic payments have developed rapidly due to continuous progress in
   electronic information technology. This study aimed to discuss the
   impact of the rapid development of electronic payments on the monetary
   system in terms of an increase in money supply, a reduction in money
   demand, and an acceleration in the velocity of money circulation. The
   changes in the monetary system had a huge impact on the policy effects
   of macroeconomic regulation, which was discussed in this paper with the
   IS - LM(Investment Equals Savings-Liquidity Preference and Money Supply)
   model. The changes in money supply compressed the space for expansionary
   monetary policy, while expanding the space for tightening monetary
   policy. The changes in money demand were more complex, monetary policy
   effects were enhanced, and fiscal policy effects were enhanced or
   weakened under different conditions. Measures should be taken to
   strengthen the theoretical research, promote the digitization of legal
   tender, enhance electronic payment monitoring, ensure the security of
   electronic payments, and optimize macroeconomic regulation policies to
   achieve a stable and healthy development of the economy of China. This
   study provided insights for better understanding the impact of
   electronic payment development and the role of effective macroeconomic
   regulation policies.},
